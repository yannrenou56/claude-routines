# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Microsoft Graph API (app registration Azure AD)
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-client-secret

# SharePoint — dossier surveillé
SHAREPOINT_SITE_ID=your-site-id
SHAREPOINT_DRIVE_ID=your-drive-id
SHAREPOINT_FOLDER_PATH=/Enregistrements/Transcripts

# Email expéditeur (doit correspondre au compte Graph)
SENDER_EMAIL=yann.renou@olisma.fr

# Slack
SLACK_BOT_TOKEN=xoxb-...

# Canal Slack par défaut si aucun projet détecté
SLACK_DEFAULT_CHANNEL=#general

# Fichier de suivi des transcripts déjà traités
PROCESSED_TRANSCRIPTS_FILE=.processed_transcripts.json

# Outlook drafter
USER_DISPLAY_NAME=Yann RENOU
